{
  "name": "justwatch",
  "version": "1.0.0",
  "private": true,
  "description": "JustWatch Search — streaming availability across every JustWatch market, deployed as a single Cloudflare Worker with D1.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "./build.sh && opennextjs-cloudflare deploy",
    "upload": "opennextjs-cloudflare build && opennextjs-cloudflare upload",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "d1:migrate:local": "wrangler d1 migrations apply justwatch-db --local",
    "d1:migrate:remote": "wrangler d1 migrations apply justwatch-db --remote",
    "d1:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "drizzle-orm": "0.45.4",
    "lucide-react": "^1.61.0",
    "next": "16.4.3",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261023.1",
    "@opennextjs/cloudflare": "1.20.13",
    "@tailwindcss/postcss": "4.1.17",
    "@types/node": "22.19.15",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "drizzle-kit": "0.31.11",
    "eslint": "9.39.4",
    "eslint-config-next": "16.4.3",
    "postcss": "8.5.8",
    "tailwindcss": "4.1.17",
    "typescript": "5.9.3",
    "wrangler": "4.152.0"
  }
}
