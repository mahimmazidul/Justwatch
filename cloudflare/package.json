{
	"name": "justwatch",
	"version": "1.0.0",
	"private": true,
	"type": "module",
	"description": "JustWatch Search — Blazor WebAssembly app plus its API proxy, deployed as one Cloudflare Worker.",
	"scripts": {
		"build": "./build.sh",
		"dev": "./build.sh && wrangler dev --ip 0.0.0.0 --port 8787",
		"deploy": "./build.sh && wrangler deploy",
		"dev:pages": "./build.sh --pages && wrangler pages dev dist --ip 0.0.0.0 --port 8788",
		"deploy:pages": "./build.sh --pages && wrangler pages deploy dist --project-name justwatch",
		"tail": "wrangler tail"
	},
	"devDependencies": {
		"wrangler": "^4.152.0"
	}
}
