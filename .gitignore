# --- Next.js / Worker build output (regenerated by cloudflare/build.sh) ---
# .next is the Turbopack build tree (~98 MB), .open-next is the converted
# Worker bundle (~25 MB) that wrangler uploads. Neither belongs in git.
cloudflare/.next/
cloudflare/.open-next/
cloudflare/next-env.d.ts
# TypeScript's incremental build cache (tsconfig.json sets "incremental": true)
*.tsbuildinfo

# --- Cloudflare / Node ---
node_modules/
.wrangler/
.dev.vars
.dev.vars.*
# The example file documents the local variables and must stay committed;
# without this negation the `.dev.vars.*` rule above swallows it.
!.dev.vars.example

# --- .NET (source/ is still a .NET project, it is just no longer deployed) ---
.dotnet/
.dotnet-install.sh
source/**/bin/
source/**/obj/
*.user
.vs/
.idea/

# --- Credentials: never commit these ---
.git-credentials
*.pem
*.key
.env
.env.*

# --- OS ---
.DS_Store
Thumbs.db

# --- Python bytecode (verify.py, fetch-fonts.py) ---
__pycache__/
*.pyc
